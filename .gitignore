# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# -------------------------
# IDE / Editors
# -------------------------
.vscode/
.idea/

# -------------------------
# OS files
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
*.key
*.pem

# -------------------------
# Climate datasets
# Large/raw datasets should not be committed
# -------------------------
data/raw/*
data/interim/*
data/processed/*

# Keep directory structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# -------------------------
# Database files
# -------------------------
*.db
*.sqlite
*.sqlite3

# -------------------------
# Temporary files
# -------------------------
*.tmp
*.temp
*.log

# -------------------------
# Generated analysis files
# -------------------------
results/figures/*
results/tables/*

!results/figures/.gitkeep
!results/tables/.gitkeep
